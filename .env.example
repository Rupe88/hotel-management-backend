# Server
NODE_ENV=development
PORT=3000

# Supabase PostgreSQL (Prisma)
# Runtime: transaction pooler (port 6543) — user is postgres.[project-ref]
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct DB host (port 5432) — user is postgres (NOT postgres.[project-ref])
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (Continue with Google for users)
# See docs/GOOGLE_OAUTH.md for Google Cloud Console setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Optional: redirect browser to your frontend after OAuth (tokens in query string)
GOOGLE_SUCCESS_REDIRECT_URL=

# AWS Lightsail Object Storage (S3-compatible)
S3_BUCKET=your-bucket-name
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_URL_BASE=https://your-bucket-name.s3.ap-south-1.amazonaws.com

# Stripe (optional – test mode simulates payment when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# App URL for Stripe redirects
APP_URL=http://localhost:3000

# Optional SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hotel.com

# Seed defaults
ADMIN_EMAIL=admin@hotel.com
ADMIN_PASSWORD=Admin@123456
