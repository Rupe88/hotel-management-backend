{
  "info": {
    "name": "Hotel Management System API",
    "description": "Phase 1 API – NestJS + Prisma + Supabase\n\nBase URL: {{baseUrl}}/api/v1\nSwagger: {{baseUrl}}/api/docs\n\n## Auth\n- Public endpoints need no token.\n- User endpoints use Bearer {{accessToken}} (from Google sign-in or refresh).\n- Admin endpoints require an admin JWT from POST /auth/admin/login.\n\n## Typical flow\n1. Admin login → saves tokens\n2. Create hotel / rooms (admin)\n3. Search availability → create booking\n4. Upload documents → checkout payment\n5. Admin approve / verify / check-in / check-out",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "hotelId", "value": "" },
    { "key": "hotelSlug", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "amenityId", "value": "" },
    { "key": "policyId", "value": "" },
    { "key": "storageKey", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotel.com\",\n  \"password\": \"your-admin-password\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/admin/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Google OAuth Status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/google/status"
          }
        },
        {
          "name": "Google OAuth (browser redirect)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/google"
          }
        },
        {
          "name": "Google Sign-In (ID token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.tokens.refreshToken);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/google/token"
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+9779800000000\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/profile"
          }
        },
        {
          "name": "Get Admin Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/admin/me"
          }
        }
      ]
    },
